{
  "name": "mind-exe",
  "private": true,
  "version": "5.4.5",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run css:build && vite",
    "css:build": "node scripts/generate-css.mjs",
    "build": "npm run css:build && vite build",
    "preview": "vite preview",
    "test": "node tests/regression.mjs",
    "test:syntax": "node --check app.js && node --check vite.config.js && node --check scripts/generate-css.mjs",
    "verify:release": "npm test && npm run test:syntax && npm run build"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "0.383.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "tailwindcss": "4.1.10",
    "vite": "7.3.5"
  }
}
